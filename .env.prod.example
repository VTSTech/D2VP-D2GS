# Public realm configuration. Copy to .env.prod and edit.
#   cp .env.prod.example .env.prod

# Address players connect to. This is what goes into the realm/server list the
# client receives, so it must be reachable from the internet: your WAN IP, or a
# hostname your clients can resolve (PvPGN expects a literal IP here).
PUBLIC_IP=203.0.113.10

# Optional: hand players on your own LAN a different address.
#LAN_IP=192.168.1.10
#LAN_NETWORK=192.168.1.0/24

# Realm identity shown in the client.
REALM_NAME=D2VP
REALM_DESCRIPTION=D2VP Closed Realm
MOTD=Welcome to D2VP!

# Game server sizing.
MAX_GAMES=50
MAX_GAME_LIFE=14400

# Shared secret between d2cs and D2GS. Generate one:
#   openssl rand -hex 16
D2GS_PASSWORD=

# D2GS admin console (telnet on 127.0.0.1:8888). The default hash is for the
# password "abcd123" - replace it before exposing anything.
#ADMIN_PASSWORD_HASH=

# Build PvPGN from a pinned local checkout instead of GitHub:
#PVPGN_BUILD_CONTEXT=/srv/pvpgn

# Packet hex logging. Leave 0 on a public server.
D2GS_DEBUG_NET_PACKET=0
